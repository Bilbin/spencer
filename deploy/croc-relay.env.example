# /etc/croc-relay/croc-relay.env  (mode 0640, root:croc-relay)
# Read by croc-relay.service (EnvironmentFile). croc reads $CROC_PASS for its global --pass flag,
# so the password never shows up in argv / ps.
# Must equal SPENCER_CROC_PASS in /etc/spencer-relay/relay.env. Generate with: openssl rand -base64 24
CROC_PASS=change-me
