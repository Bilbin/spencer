# /etc/spencer-relay/relay.env  (mode 0640, root:spencer-relay)
# Read by spencer-relay.service (EnvironmentFile). See docs/PROTOCOL.md §4.5.

# Listen address. Keep it on loopback; nginx terminates TLS and proxies /ws.
SPENCER_RELAY_HOST=127.0.0.1
SPENCER_RELAY_PORT=8820

# SQLite database (WAL mode). StateDirectory=spencer-relay provides /var/lib/spencer-relay.
SPENCER_RELAY_DB=/var/lib/spencer-relay/relay.sqlite

# Undelivered messages are deleted after this many days, acked or not.
SPENCER_RELAY_TTL_DAYS=14

# croc relay handed to clients in welcome/create/join, but only to identities that are members
# of at least one channel. Set SPENCER_CROC_RELAY= (empty) to turn this off. If
# SPENCER_CROC_PASS is empty, no croc info is sent.
SPENCER_CROC_RELAY=spencer.pjalv.com:9009
# Must equal CROC_PASS in /etc/croc-relay/croc-relay.env. Generate with: openssl rand -base64 24
SPENCER_CROC_PASS=change-me
